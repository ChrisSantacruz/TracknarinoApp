NODE_ENV=staging
PORT=4000
MONGO_URI=mongodb://mongo:27017/tracknarino_staging
JWT_SECRET=replace-with-staging-secret
REDIS_URL=redis://redis:6379
SOCKET_IO_REDIS_URL=redis://redis:6379
SOCKET_IO_REDIS_KEY=tracknarino:staging:socket.io
TRACKNARINO_NODE_ID=staging-node-1
SOCKET_RECOVERY_MS=120000
SOCKET_RECONNECT_STORM_THRESHOLD=40
ROUTING_PROVIDER=public_osrm
OSRM_TIMEOUT_MS=12000
OSRM_RETRY_COUNT=1
OPERATIONAL_VALIDATION_TOOLS=true
OPERATIONAL_METRICS_WINDOW_MS=300000
OPERATIONAL_METRICS_MAX_SAMPLES=500
SHUTDOWN_TIMEOUT_MS=10000
