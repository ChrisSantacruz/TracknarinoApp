NODE_ENV=development
PORT=4000
MONGO_URI=mongodb://localhost:27017/trackarino
JWT_SECRET=replace-with-a-long-random-secret

# Routing provider policy
ROUTING_PROVIDER=public_osrm
OSRM_BASE_URL=https://router.project-osrm.org/route/v1/driving
OSRM_TIMEOUT_MS=12000
OSRM_RETRY_COUNT=1

# Realtime scaling
SOCKET_RECOVERY_MS=120000
SOCKET_RECONNECT_STORM_THRESHOLD=40
TRACKNARINO_NODE_ID=local-node
SOCKET_IO_REDIS_URL=
SOCKET_IO_REDIS_KEY=tracknarino:socket.io

# Operational validation tooling
OPERATIONAL_VALIDATION_TOOLS=false
TRACKNARINO_VALIDATION_TOKEN=
TRACKNARINO_VALIDATION_SINCE_HOURS=24
TRACKNARINO_VALIDATION_SCENARIO=manual_capture
TRACKNARINO_VALIDATION_OUTPUT_DIR=validation-runs

# Shutdown
SHUTDOWN_TIMEOUT_MS=10000
